---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Modals from '../../components/Modals.astro';
import RealCoverageMap from '../../components/RealCoverageMap.astro';
import { ontarioLocations, type LocationInfo } from '../../data/locations';
import { therapyTeamsData } from '../../data/therapyTeams';
import { servicesData } from '../../data/services';

export function getStaticPaths() {
  return ontarioLocations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: LocationInfo;
}

const { location } = Astro.props;

// Filter matching or nearby clinical teams based on regionSlug
const matchingTeams = therapyTeamsData.filter((t) => {
  if (location.regionSlug === 'toronto' && t.region === 'toronto') return true;
  if (location.regionSlug === 'peel' && t.region === 'peel') return true;
  if (location.regionSlug === 'york' && t.region === 'york') return true;
  if (location.regionSlug === 'hamilton' && (t.region === 'hamilton' || t.region === 'peel')) return true;
  if (location.regionSlug === 'niagara' && t.region === 'hamilton') return true;
  if (location.regionSlug === 'waterloo' && (t.region === 'waterloo' || t.region === 'hamilton')) return true;
  if (location.regionSlug === 'barrie' && (t.region === 'york' || t.region === 'toronto')) return true;
  if (location.regionSlug === 'durham' && (t.region === 'toronto' || t.region === 'york')) return true;
  if (location.regionSlug === 'peterborough' && (t.region === 'toronto' || t.region === 'york')) return true;
  if (location.regionSlug === 'ottawa' && t.region === 'ottawa') return true;
  return false;
});

const displayTeams = matchingTeams.length > 0 ? matchingTeams : therapyTeamsData.slice(0, 3);

const pageTitle = `In-Home Autism Therapy in ${location.name}, Ontario | ABA, Speech & OT`;
const pageDescription = `Dedicated in-home ABA therapy, Speech-Language Pathology, and Occupational Therapy in ${location.name}, Ontario (${location.postalPrefixes.slice(0, 3).join(', ')}). Supervised by Registered Behaviour Analysts (R.B.A. Ont.). OAP approved.`;

// Localized MedicalBusiness and Structured Entity Graph
const cityPageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MedicalBusiness', 'LocalBusiness'],
      '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#medicalbusiness`,
      name: `Side by Side Therapy Connect - ${location.name}`,
      legalName: 'Side by Side Therapy Inc.',
      url: `https://sidebysidetherapyconnect.ca/locations/${location.slug}`,
      logo: 'https://sidebysidetherapyconnect.ca/images/sbs-logo.png',
      image: 'https://sidebysidetherapyconnect.ca/images/sbs-logo.png',
      telephone: '+1-877-797-0477',
      email: 'info@sidebysidetherapy.ca',
      description: location.description,
      priceRange: '$$$',
      currenciesAccepted: 'CAD',
      paymentAccepted: 'Ontario Autism Program (OAP), Private Health Insurance, Direct Billing, Credit Card',
      address: {
        '@type': 'PostalAddress',
        addressLocality: location.name,
        addressRegion: 'ON',
        addressCountry: 'CA',
        postalCode: location.postalPrefixes[0] || 'L5B',
      },
      areaServed: [
        {
          '@type': 'City',
          name: location.name,
          containedInPlace: {
            '@type': 'AdministrativeArea',
            name: `${location.region}, Ontario, Canada`,
          },
        },
        ...location.nearbyAreas.map((nearby) => ({
          '@type': 'AdministrativeArea',
          name: `${nearby}, Ontario`,
        })),
      ],
      medicalSpecialty: [
        'Applied Behaviour Analysis',
        'Speech-Language Pathology',
        'Occupational Therapy',
        'Psycho-Educational Assessment',
        'Pediatric Respite',
        'Assent-based behavioral therapy',
        'Neurodiversity-affirming care',
      ],
      availableService: servicesData.map((s) => ({
        '@type': 'TherapeuticProcedure',
        name: `${s.name} in ${location.name}`,
        description: `${s.tagline} Delivered in-home and in community settings across ${location.name}, ${location.region}.`,
        provider: {
          '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#medicalbusiness`,
        },
      })),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `In-Home Autism Therapy Services in ${location.name}`,
        itemListElement: servicesData.map((s) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: `${s.name} (${location.name})`,
            description: s.description,
          },
          priceCurrency: 'CAD',
          eligibleRegion: {
            '@type': 'City',
            name: location.name,
          },
        })),
      },
      parentOrganization: {
        '@type': 'MedicalOrganization',
        name: 'Side by Side Therapy Inc.',
        url: 'https://www.sidebysidetherapy.ca',
      },
      knowsAbout: [
        ...location.localKeywords,
        ...(location.localContext?.schoolBoards || []),
        ...(location.schools?.map((sch) => sch.name) || []),
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://sidebysidetherapyconnect.ca/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Ontario Service Locations',
          item: 'https://sidebysidetherapyconnect.ca/locations',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: location.name,
          item: `https://sidebysidetherapyconnect.ca/locations/${location.slug}`,
        },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#webpage`,
      url: `https://sidebysidetherapyconnect.ca/locations/${location.slug}`,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Side by Side Therapy Connect',
        url: 'https://sidebysidetherapyconnect.ca',
      },
      breadcrumb: {
        '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#breadcrumb`,
      },
      mainEntity: {
        '@id': `https://sidebysidetherapyconnect.ca/locations/${location.slug}#medicalbusiness`,
      },
    },
  ],
};

const iconSvgMap: Record<string, string> = {
  brain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  speech: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
  puzzle: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />',
  clipboard: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />',
  chat: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />',
  shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  academic: '<path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />'
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={cityPageSchema}>
  <Header />

  <main class="flex-grow">
    <!-- BREADCRUMBS NAVIGATION -->
    <nav aria-label="Breadcrumb" class="bg-brand-surface border-b border-brand-border py-3 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a href="/" class="hover:text-brand-orchid transition-colors">Home</a>
        <span>/</span>
        <a href="/locations" class="hover:text-brand-orchid transition-colors">Locations</a>
        <span>/</span>
        <span class="text-brand-dark font-bold">{location.name}</span>
      </div>
    </nav>

    <!-- LOCATION HERO SECTION -->
    <section class="relative overflow-hidden pt-12 pb-16 md:pt-16 md:pb-24 bg-gradient-to-b from-white via-brand-surface to-white border-b border-brand-border">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-peony/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
      <div class="absolute top-10 right-10 w-80 h-80 bg-brand-ocean/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-peony/50 text-brand-dark shadow-sm text-xs font-semibold mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Serving {location.name} ({location.region}) &bull; Population: {location.populationEstimate}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.15]">
            In-Home Autism &amp; Therapy Services in <span class="brand-gradient-text">{location.name}, Ontario</span>
          </h1>

          <p class="mt-6 text-lg sm:text-xl text-slate-600 font-medium leading-relaxed">
            {location.description}
          </p>

          <p class="mt-3 text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
            Families across <strong>{location.name}</strong> receive dedicated, 1-on-1 natural environment teaching in their living room, kitchen, or local community. Every session is directly supervised by a licensed Ontario <strong class="text-brand-ocean">Registered Behaviour Analyst (R.B.A. Ont.)</strong>, ensuring strict compliance with <a href="https://cpbao.ca" target="_blank" rel="noopener noreferrer" class="text-brand-orchid hover:underline font-bold inline-flex items-center gap-0.5" title="College of Psychologists and Behaviour Analysts of Ontario"><span>CPBAO Standard 4</span><svg class="w-3.5 h-3.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a> and direct eligibility for <a href="https://www.ontario.ca/page/ontario-autism-program" target="_blank" rel="noopener noreferrer" class="text-brand-orchid hover:underline font-bold inline-flex items-center gap-0.5" title="Ontario Autism Program Guidelines"><span>Ontario Autism Program (OAP) funding</span><svg class="w-3.5 h-3.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a>.
          </p>

          <!-- Quick Regulatory Verification Links -->
          <div class="mt-4 flex flex-wrap items-center gap-2.5 text-xs">
            <a
              href="https://cpbao.ca/public-register/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-brand-border text-slate-700 hover:border-brand-orchid hover:text-brand-dark font-semibold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-brand-ocean"></span>
              <span class="group-hover:underline">Verify CPBAO Public Register</span>
              <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-ocean" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://www.ontario.ca/page/ontario-autism-program"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-brand-border text-slate-700 hover:border-brand-orchid hover:text-brand-dark font-semibold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="group-hover:underline">OAP Core Clinical Funding</span>
              <svg class="w-3 h-3 text-slate-400 group-hover:text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://accessoap.ca"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-brand-border text-slate-700 hover:border-brand-orchid hover:text-brand-dark font-semibold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-brand-peony"></span>
              <span class="group-hover:underline">AccessOAP Portal</span>
              <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-peony" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <button
              type="button"
              data-start-intake-location={location.name}
              class="px-8 py-3.5 rounded-full brand-gradient text-white font-bold text-sm shadow-glow-orchid hover:opacity-95 transition-all active:scale-95 flex items-center gap-2"
            >
              <span>Match with a Team in {location.name}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <a
              href="#local-services"
              class="px-6 py-3.5 rounded-full bg-white hover:bg-brand-surface text-slate-700 font-bold text-sm border border-brand-border transition-all shadow-sm"
            >
              Explore {location.name} Services ↓
            </a>
          </div>

          <div class="mt-8 pt-6 border-t border-brand-border flex flex-wrap items-center gap-2 text-xs text-slate-500 font-medium">
            <span class="font-bold text-slate-700 uppercase tracking-wider text-[11px] mr-1">Postal Code Prefixes Serviced in {location.name}:</span>
            {location.postalPrefixes.map((prefix) => (
              <span class="px-2.5 py-1 rounded-md bg-white border border-brand-border text-slate-700 font-mono text-[11px] font-bold">
                {prefix}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: UNIQUE LOCAL COMMUNITY CONTEXT (WHY IN-HOME IN THIS CITY) -->
    {location.localContext && (
      <section class="py-16 bg-white border-b border-brand-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mb-10">
            <span class="text-xs uppercase tracking-widest font-bold text-brand-ocean">Local Clinical Context</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2">
              Why In-Home Therapy Works Best for Families in {location.name}
            </h2>
            <p class="mt-2 text-slate-600 text-sm font-medium">
              We tailor therapy delivery around the unique geographic and educational landscape of {location.name}.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border">
              <span class="text-xs font-bold text-brand-orchid uppercase tracking-wider block mb-2">🚗 Zero Commute Stress</span>
              <h3 class="font-bold text-slate-900 text-base mb-2">Eliminating Local Traffic</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-3">
                {location.localContext.travelFocus}
              </p>
              <p class="text-[11px] text-slate-500">
                Instead of losing focus in the car, your child begins sessions energized in their familiar home space.
              </p>
            </div>

            <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border">
              <span class="text-xs font-bold text-brand-ocean uppercase tracking-wider block mb-2">🏫 School &amp; IEP Support</span>
              <h3 class="font-bold text-slate-900 text-base mb-2">Local Board Coordination</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-3">
                Our Supervising RBAs help align Behaviour Service Plans with local school boards serving {location.name}:
              </p>
              <ul class="space-y-1.5 text-xs text-slate-700 font-semibold">
                {location.localContext.schoolBoards.map((board) => (
                  <li class="flex items-center justify-between gap-2 py-0.5 border-b border-brand-border/40 last:border-0">
                    <span class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-brand-ocean"></span>
                      <span>{board}</span>
                    </span>
                    <a
                      href={`https://www.google.com/search?q=${encodeURIComponent(board + ' special education IEP')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Open ${board} Special Education Portal`}
                      class="text-[10px] text-brand-orchid hover:underline inline-flex items-center gap-0.5 font-bold shrink-0"
                    >
                      <span>Special Ed Portal ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border">
              <span class="text-xs font-bold text-brand-berry uppercase tracking-wider block mb-2">🤝 Collaborative Care</span>
              <h3 class="font-bold text-slate-900 text-base mb-2">Community Alliances</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-3">
                {location.localContext.communityResources}
              </p>
              <p class="text-[11px] text-slate-500">
                {location.localContext.localChallengeHighlight}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- SECTION: UNIQUE LOCALIZED SERVICES DIRECTORY FOR THIS CITY -->
    <section id="local-services" class="py-20 bg-brand-surface border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-xs uppercase tracking-widest font-bold text-brand-orchid">Transdisciplinary Care</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-2">
            Pediatric Therapy Services Available in {location.name}
          </h2>
          <p class="mt-3 text-slate-600 text-sm sm:text-base font-medium">
            All services delivered in-home, at local {location.name} daycares, or in private school settings. Seamlessly integrated to ensure consistency across communication, daily life skills, and motor goals.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicesData.map((service) => (
            <article class="bg-white rounded-3xl p-7 border border-brand-border shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-brand-surface border border-brand-border flex items-center justify-center text-brand-orchid mb-4 group-hover:scale-105 group-hover:text-brand-ocean transition-all">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconSvgMap[service.icon] || iconSvgMap.brain} />
                </div>

                <h3 class="text-lg font-bold text-slate-900 leading-snug group-hover:text-brand-orchid transition-colors mb-1">
                  {service.name} in {location.name}
                </h3>
                <p class="text-xs text-brand-ocean font-semibold mb-3">{service.tagline}</p>

                <p class="text-xs text-slate-600 leading-relaxed mb-4">
                  {service.description.replace('in your home', `in your ${location.name} home`)}
                </p>

                <div class="mb-4">
                  <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">{location.name} Clinical Focus:</span>
                  <ul class="space-y-1 text-xs text-slate-700">
                    {service.keyOutcomes.slice(0, 3).map((outcome) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-brand-orchid font-bold text-xs mt-0.5">•</span>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
                <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  OAP / Insurance Eligible
                </span>
                <button
                  type="button"
                  data-start-intake-service={`${service.shortTag} in ${location.name}`}
                  class="text-xs font-bold text-brand-orchid hover:underline"
                >
                  Book for {location.name} &rarr;
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION: LOCAL PUBLIC SCHOOLS & REGIONAL IMAGE MAP -->
    {location.schools && location.schools.length > 0 && (
      <section class="py-20 bg-white border-b border-brand-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mb-12">
            <span class="text-xs uppercase tracking-widest font-bold text-brand-ocean">School IEP &amp; Community Coordination</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-2">
              Local Schools in {location.name} &amp; Educational Support
            </h2>
            <p class="mt-3 text-slate-600 text-sm sm:text-base font-medium">
              Our clinical supervisors collaborate with educators and special education resource teachers across {location.name} to align Behaviour Service Plans (BSPs), sensory accommodations, and assistive AAC goals.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left: Realistic Interactive Cartographic Coverage Map -->
            <div class="lg:col-span-6">
              <RealCoverageMap location={location} />
            </div>

            <!-- Right: List of Representative Schools with Descriptions -->
            <div class="lg:col-span-6 space-y-4">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">
                Sample Public &amp; Catholic School Alignments in {location.name}:
              </span>

              {location.schools.map((school, index) => (
                <div class="p-5 rounded-2xl bg-brand-surface border border-brand-border hover:border-brand-orchid transition-all">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
                    <h3 class="font-bold text-slate-900 text-base">
                      <a
                        href={school.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Visit official website of ${school.name}`}
                        class="hover:text-brand-orchid transition-colors inline-flex items-center gap-2 group"
                      >
                        <span class="w-6 h-6 rounded-lg bg-brand-orchid/10 text-brand-orchid text-xs flex items-center justify-center font-bold shrink-0">
                          {index + 1}
                        </span>
                        <span class="group-hover:underline">{school.name}</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-brand-orchid shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </h3>
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-white border border-brand-border text-brand-dark shrink-0">
                      {school.grades}
                    </span>
                  </div>

                  <div class="text-xs font-bold text-brand-ocean mb-2">
                    {school.type}
                  </div>

                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                    <strong>IEP &amp; Classroom Transition Focus:</strong> {school.iepFocus}
                  </p>

                  <div class="pt-2.5 border-t border-brand-border/60 flex flex-wrap items-center justify-between gap-2 text-xs">
                    <a
                      href={school.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Visit official website of ${school.name}`}
                      class="text-brand-orchid hover:underline font-bold inline-flex items-center gap-1.5"
                    >
                      <span>Visit Official School Website</span>
                      <svg class="w-3.5 h-3.5 text-brand-orchid" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                      Private In-Home Team Aligned
                    </span>
                  </div>
                </div>
              ))}

              <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-600 leading-relaxed">
                <strong>Need IEP or School Meeting Representation?</strong> Our Supervising Registered Behaviour Analysts (R.B.A. Ont.) can participate in school transition meetings, review IPRC placements, and help teachers implement positive behaviour support plans for children in {location.name}.
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- AVAILABLE TEAMS COVERING THIS AREA -->
    <section id="local-teams" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-xs uppercase tracking-widest font-bold text-brand-ocean">Local Clinical Network</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-2">
            Clinical Duos Servicing {location.name}
          </h2>
          <p class="mt-3 text-slate-600 text-sm sm:text-base font-medium">
            Pre-paired Instructor Therapists and Supervising RBAs accepting clients for in-home sessions in {location.name} and surrounding communities.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {displayTeams.map((team) => (
            <article class="bg-brand-surface rounded-3xl p-6 border border-brand-border shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-white text-brand-dark border border-brand-border">
                    <svg class="w-3 h-3 text-brand-ocean" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                    </svg>
                    Covers {location.name}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                    In-Home Ready
                  </span>
                </div>

                <div class="flex items-center gap-4 mb-4">
                  <img
                    src={team.therapist.avatar}
                    alt={team.therapist.name}
                    loading="lazy"
                    class="w-14 h-14 rounded-2xl object-cover border-2 border-brand-orchid/30 shadow-sm"
                  />
                  <div>
                    <h3 class="font-bold text-slate-900 text-lg leading-snug group-hover:text-brand-orchid transition-colors">
                      {team.therapist.name}
                    </h3>
                    <span class="text-xs font-semibold text-brand-orchid block">{team.therapist.title}</span>
                    <span class="text-[11px] text-slate-400 font-medium">{team.therapist.experience}</span>
                  </div>
                </div>

                <div class="p-3.5 rounded-2xl bg-white border border-brand-border mb-4 text-xs">
                  <div class="flex items-center justify-between text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">
                    <span>Supervising Registrant</span>
                    <span class="text-brand-ocean font-mono">{team.supervisor.cpbaoReg}</span>
                  </div>
                  <div class="font-bold text-slate-800 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-brand-ocean" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    {team.supervisor.name}
                  </div>
                  <div class="text-[11px] text-slate-500 mt-0.5">{team.supervisor.credentials}</div>
                </div>

                <div class="flex flex-wrap gap-1.5 mb-6">
                  {team.disciplines.map((d) => (
                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white text-slate-600 border border-brand-border/60">{d}</span>
                  ))}
                </div>
              </div>

              <div class="pt-4 border-t border-brand-border/80">
                <button
                  type="button"
                  data-match-specific-team={team.id}
                  data-team-location={location.name}
                  class="w-full py-2.5 rounded-xl brand-gradient text-white font-bold text-xs shadow-glow-orchid hover:opacity-95 transition-all text-center"
                >
                  Request Match with This Team in {location.name}
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- NEARBY SERVICE AREAS -->
    <section class="py-16 bg-brand-surface border-t border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-slate-900 mb-4">
          Adjacent In-Home Service Locations to {location.name}
        </h2>
        <p class="text-sm text-slate-600 mb-6 max-w-2xl">
          Our clinicians travel throughout {location.region}. We also support families residing in neighbouring communities:
        </p>

        <div class="flex flex-wrap gap-2">
          {location.nearbyAreas.map((area) => {
            const matchedLocation = ontarioLocations.find(
              (l) => l.name.toLowerCase() === area.toLowerCase() || l.name.toLowerCase().includes(area.toLowerCase())
            );
            return matchedLocation ? (
              <a
                href={`/locations/${matchedLocation.slug}`}
                class="px-4 py-2 rounded-xl bg-white hover:bg-brand-peony/20 border border-brand-border text-xs font-bold text-brand-dark transition-colors"
              >
                {area} &rarr;
              </a>
            ) : (
              <span class="px-4 py-2 rounded-xl bg-slate-100 border border-slate-200 text-xs font-medium text-slate-600">
                {area}
              </span>
            );
          })}
        </div>

        <div class="mt-8 pt-6 border-t border-brand-border/60">
          <a href="/locations" class="text-xs font-bold text-brand-orchid hover:underline inline-flex items-center gap-1">
            &larr; View All Ontario Service Hubs (GTA, Hamilton, Niagara, Waterloo, Simcoe, Ottawa)
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Modals />

  <script>
    import { therapyTeamsData } from '../../data/therapyTeams';

    const intakeModal = document.getElementById('intakeModal') as HTMLDialogElement | null;

    document.querySelectorAll<HTMLElement>('[data-start-intake-location]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const loc = btn.dataset.startIntakeLocation || '';
        const notes = document.getElementById('intakeNotes') as HTMLTextAreaElement | null;
        if (notes && loc) {
          notes.value = `Family requesting in-home therapy services in ${loc}.`;
        }
        intakeModal?.showModal();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-start-intake-service]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const srv = btn.dataset.startIntakeService || '';
        const notes = document.getElementById('intakeNotes') as HTMLTextAreaElement | null;
        if (notes && srv) {
          notes.value = `Family inquiring about ${srv}.`;
        }
        intakeModal?.showModal();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-match-specific-team]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const teamId = btn.dataset.matchSpecificTeam || '';
        const loc = btn.dataset.teamLocation || '';
        const team = therapyTeamsData.find((t) => t.id === teamId);
        const notes = document.getElementById('intakeNotes') as HTMLTextAreaElement | null;
        if (notes && team) {
          notes.value = `Requesting match with ${team.therapist.name} & ${team.supervisor.name} in ${loc}.`;
        }
        intakeModal?.showModal();
      });
    });
  </script>
</BaseLayout>
