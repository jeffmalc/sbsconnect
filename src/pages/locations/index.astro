---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Modals from '../../components/Modals.astro';
import OntarioCoverageMap from '../../components/OntarioCoverageMap.astro';
import { ontarioLocations } from '../../data/locations';

const pageTitle = 'Ontario Service Locations & In-Home ABA Coverage | Side by Side Therapy Connect';
const pageDescription = 'Find vetted, independent in-home autism therapy teams across Toronto, GTA, Peel, York, Halton, Durham, Hamilton, Niagara, Waterloo, Simcoe County, and Eastern Ontario.';

// Group locations by region
const regionsMap: Record<string, typeof ontarioLocations> = {};
ontarioLocations.forEach((loc) => {
  if (!regionsMap[loc.region]) {
    regionsMap[loc.region] = [];
  }
  regionsMap[loc.region].push(loc);
});

const regionsList = Object.keys(regionsMap);

const locationsIndexSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://sidebysidetherapyconnect.ca/locations#webpage',
      url: 'https://sidebysidetherapyconnect.ca/locations',
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Side by Side Therapy Connect',
        url: 'https://sidebysidetherapyconnect.ca',
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://sidebysidetherapyconnect.ca/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Ontario Service Locations',
            item: 'https://sidebysidetherapyconnect.ca/locations',
          },
        ],
      },
    },
    {
      '@type': 'MedicalBusiness',
      '@id': 'https://sidebysidetherapyconnect.ca/#organization',
      name: 'Side by Side Therapy Connect',
      legalName: 'Side by Side Therapy Inc.',
      url: 'https://sidebysidetherapyconnect.ca',
      telephone: '+1-877-797-0477',
      email: 'info@sidebysidetherapy.ca',
      description: 'Connecting Ontario families with vetted in-home autism therapy teams across 68+ cities in the Greater Toronto Area and surrounding regions within 250km.',
      areaServed: ontarioLocations.map((loc) => ({
        '@type': 'City',
        name: loc.name,
      })),
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={locationsIndexSchema}>
  <Header />

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="py-16 md:py-20 bg-gradient-to-b from-white via-brand-surface to-white border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-peony/50 text-brand-dark shadow-sm text-xs font-semibold mb-6">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-ocean animate-pulse"></span>
          <span>Coverage Across Greater Toronto & Southern Ontario (Within 250km)</span>
        </span>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 leading-[1.15]">
          Ontario In-Home Autism Therapy <span class="brand-gradient-text">Service Locations</span>
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-600 font-medium leading-relaxed max-w-3xl mx-auto">
          We connect families directly with certified Instructor Therapists supervised by Registered Behaviour Analysts (R.B.A. Ont.) across every city in the GTA, Golden Horseshoe, and surrounding communities within 250km of Toronto.
        </p>

        <!-- Fast Intake Trigger -->
        <div class="mt-8">
          <button
            type="button"
            data-start-intake-wizard
            class="px-8 py-3.5 rounded-full brand-gradient text-white font-bold text-sm shadow-glow-orchid hover:opacity-95 transition-all active:scale-95"
          >
            Find My Local In-Home Team
          </button>
        </div>
      </div>
    </section>

    <!-- REALISTIC INTERACTIVE PROVINCE-WIDE COVERAGE MAP -->
    <OntarioCoverageMap />

    <!-- LOCATIONS DIRECTORY GROUPED BY REGION -->
    <section class="py-20 bg-brand-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        {regionsList.map((regionName) => {
          const cities = regionsMap[regionName];
          return (
            <div class="bg-white rounded-3xl p-6 sm:p-10 border border-brand-border shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-brand-border pb-4 mb-6">
                <h2 class="text-2xl font-bold text-slate-900">{regionName}</h2>
                <span class="text-xs font-semibold text-brand-orchid uppercase tracking-wider">
                  {cities.length} Service Areas Available
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {cities.map((city) => (
                  <a
                    href={`/locations/${city.slug}`}
                    class="group p-4 rounded-2xl bg-brand-surface hover:bg-brand-peony/20 border border-brand-border hover:border-brand-orchid transition-all flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1 mb-1">
                        <h3 class="font-bold text-sm text-slate-900 group-hover:text-brand-orchid transition-colors">
                          {city.name}
                        </h3>
                        <span class="text-slate-400 group-hover:text-brand-orchid transition-transform group-hover:translate-x-1 text-xs">
                          &rarr;
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                        {city.description}
                      </p>
                    </div>

                    <div class="mt-3 pt-2 border-t border-brand-border/60 flex items-center justify-between text-[10px] text-slate-400 font-medium">
                      <span>{city.postalPrefixes[0]}...</span>
                      <span>In-Home Teams</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <Footer />
  <Modals />

  <script>
    const intakeModal = document.getElementById('intakeModal') as HTMLDialogElement | null;
    document.querySelectorAll('[data-start-intake-wizard]').forEach((btn) => {
      btn.addEventListener('click', () => intakeModal?.showModal());
    });
  </script>
</BaseLayout>
