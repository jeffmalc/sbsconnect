---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Protected Access | Side by Side Therapy Connect"
  description="Enter the access password to preview Side by Side Therapy Connect."
>
  <main class="min-h-screen bg-gradient-to-b from-brand-dark via-brand-darker to-brand-dark text-white flex flex-col justify-center items-center p-4 relative overflow-hidden">
    <!-- Ambient glowing backdrop blobs -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-orchid/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-brand-ocean/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-md w-full bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl relative text-center">
      <!-- Brand Logo Mark -->
      <div class="w-14 h-14 rounded-2xl brand-gradient flex items-center justify-center text-white shadow-glow-orchid mx-auto mb-6">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
      </div>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/10 text-brand-peony border border-white/15 mb-3">
        🔒 Private Staging Access
      </span>

      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
        Side by Side Therapy
      </h1>
      <p class="text-xs text-slate-300 leading-relaxed mb-6">
        This preview site is currently password-protected. Please enter your team access password below to continue.
      </p>

      <!-- Password Form -->
      <form id="passwordForm" class="space-y-4 text-left">
        <div>
          <label for="sitePassword" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            Password
          </label>
          <div class="relative">
            <input
              type="password"
              id="sitePassword"
              name="password"
              autofocus
              required
              autocomplete="current-password"
              placeholder="Enter password..."
              class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-orchid focus:ring-2 focus:ring-brand-orchid/30 transition-all pr-11"
            />
            <button
              type="button"
              id="togglePasswordBtn"
              aria-label="Toggle password visibility"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white transition-colors"
            >
              <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </button>
          </div>
          <p id="errorMessage" class="text-xs font-medium text-rose-400 mt-2 hidden" role="alert">
            Incorrect password. Please try again.
          </p>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-2xl brand-gradient text-white font-bold text-sm shadow-glow-orchid hover:opacity-95 transition-all flex items-center justify-center gap-2 active:scale-98"
        >
          <span>Unlock Site</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-white/10 text-center">
        <span class="text-[11px] text-slate-400">
          Authorized Team &amp; Client Access Only
        </span>
      </div>
    </div>
  </main>

  <script>
    const form = document.getElementById('passwordForm') as HTMLFormElement | null;
    const passwordInput = document.getElementById('sitePassword') as HTMLInputElement | null;
    const errorMessage = document.getElementById('errorMessage');
    const toggleBtn = document.getElementById('togglePasswordBtn');

    // Toggle password visibility
    toggleBtn?.addEventListener('click', () => {
      if (!passwordInput) return;
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
    });

    // Check if already authenticated, redirect to destination
    if (sessionStorage.getItem('sbs_auth') === 'true') {
      const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
      window.location.replace(returnUrl);
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const entered = passwordInput?.value || '';

      if (entered === 'SBS@2020!') {
        sessionStorage.setItem('sbs_auth', 'true');
        errorMessage?.classList.add('hidden');
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';
        window.location.replace(returnUrl);
      } else {
        errorMessage?.classList.remove('hidden');
        passwordInput?.classList.add('border-rose-400');
        passwordInput?.focus();
      }
    });
  </script>
</BaseLayout>
