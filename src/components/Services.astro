---
import { servicesData } from '../data/services';

const iconSvgMap: Record<string, string> = {
  brain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  speech: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
  puzzle: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />',
  clipboard: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />',
  chat: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />',
  shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  academic: '<path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />'
};

const categoryBadgeMap: Record<string, { label: string; colorClass: string }> = {
  core: { label: 'Behavioural Core', colorClass: 'bg-brand-orchid/10 text-brand-orchid border-brand-orchid/20' },
  allied: { label: 'Allied Clinical', colorClass: 'bg-brand-ocean/10 text-brand-ocean border-brand-ocean/20' },
  assessment: { label: 'Formal Assessment', colorClass: 'bg-amber-500/10 text-amber-700 border-amber-500/20' },
  support: { label: 'Family & Play Support', colorClass: 'bg-emerald-500/10 text-emerald-700 border-emerald-500/20' }
};
---

<!-- SECTION: COMPREHENSIVE CLINICAL SERVICES -->
<section id="services" class="py-20 bg-white border-t border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-berry/10 text-xs uppercase tracking-widest font-extrabold text-brand-berry">
        <span aria-hidden="true">🧩</span> Whole-Child Support
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">
        Playful, Coordinated Care Under One Roof
      </h2>
      <p class="mt-4 text-slate-600 font-medium leading-relaxed text-base sm:text-lg">
        From child-led in-home ABA and Speech-Language Pathology to Occupational Therapy, Respite, and Psycho-Educational Assessments—your child’s entire team collaborates and shares milestones every single week.
      </p>
    </div>

    <!-- Interactive Service Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-12" id="serviceCategoryFilters">
      <button
        type="button"
        data-service-cat="all"
        class="service-cat-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-brand-orchid text-white shadow-sm"
      >
        ✨ All 9 Services
      </button>
      <button
        type="button"
        data-service-cat="core"
        class="service-cat-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-brand-surface text-slate-800 border border-brand-border hover:bg-brand-peony/25"
      >
        🧩 Behavioural &amp; Play
      </button>
      <button
        type="button"
        data-service-cat="allied"
        class="service-cat-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-brand-surface text-slate-800 border border-brand-border hover:bg-brand-peony/25"
      >
        🗣️ Speech &amp; OT
      </button>
      <button
        type="button"
        data-service-cat="assessment"
        class="service-cat-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-brand-surface text-slate-800 border border-brand-border hover:bg-brand-peony/25"
      >
        📋 Assessments
      </button>
      <button
        type="button"
        data-service-cat="support"
        class="service-cat-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-brand-surface text-slate-800 border border-brand-border hover:bg-brand-peony/25"
      >
        💛 Family &amp; Respite
      </button>
    </div>

    <!-- 9 Core Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="servicesGrid">
      {servicesData.map((service) => {
        const categoryBadge = categoryBadgeMap[service.category] || categoryBadgeMap.core;
        return (
          <article
            data-service-card={service.category}
            class="card-playful scroll-reveal bg-brand-surface/70 p-7 sm:p-8 border-2 border-brand-border flex flex-col justify-between group"
          >
            <div>
              <!-- Category Badge & Header -->
              <div class="flex items-center justify-between gap-2 mb-5">
                <span class={`px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider border ${categoryBadge.colorClass}`}>
                  {categoryBadge.label}
                </span>
                <span class="text-xs font-bold text-slate-500">
                  🏡 In-Home
                </span>
              </div>

              <!-- Title & Tagline -->
              <div class="flex items-start gap-3.5 mb-4">
                <div class="w-13 h-13 p-3 rounded-2xl bg-white border-2 border-brand-border flex items-center justify-center text-brand-orchid shadow-sm shrink-0 group-hover:scale-110 group-hover:bg-brand-orchid group-hover:text-white transition-all">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconSvgMap[service.icon] || iconSvgMap.brain} />
                </div>
                <div>
                  <h3 class="text-xl font-extrabold text-slate-900 leading-snug group-hover:text-brand-orchid transition-colors">
                    {service.name}
                  </h3>
                  <p class="text-xs sm:text-sm text-brand-orchid font-bold mt-0.5">{service.tagline}</p>
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm text-slate-700 font-medium leading-relaxed mb-5">
                {service.description}
              </p>

              <!-- Key Outcomes Checklist -->
              <div class="mb-5 bg-white/80 p-4 rounded-2xl border border-brand-border/70">
                <span class="block text-xs font-extrabold uppercase tracking-wider text-brand-dark mb-2.5">Playful Milestones:</span>
                <ul class="space-y-2 text-xs sm:text-sm text-slate-800 font-medium">
                  {service.keyOutcomes.map((outcome) => (
                    <li class="flex items-start gap-2">
                      <span class="text-brand-ocean font-extrabold shrink-0 mt-0.5">✓</span>
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Funding Badges -->
              <div class="pt-3 border-t border-brand-border/60 mb-6 flex flex-wrap gap-1.5">
                {service.fundingEligibility.map((fund) => (
                  <span class="px-2.5 py-1 rounded-full bg-white border border-brand-border text-xs font-bold text-slate-700">
                    {fund}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action CTA Button -->
            <button
              type="button"
              data-prefill-goal={service.intakeGoalTag}
              class="btn-playful w-full py-3 rounded-2xl bg-white border-2 border-brand-orchid text-brand-orchid text-xs sm:text-sm font-extrabold hover:bg-brand-orchid hover:text-white transition-all shadow-sm"
            >
              Match for {service.shortTag} →
            </button>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.service-cat-btn');
  const serviceCards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedCat = btn.getAttribute('data-service-cat') || 'all';

      catBtns.forEach((b) => {
        b.classList.remove('bg-brand-orchid', 'text-white', 'shadow-sm');
        b.classList.add('bg-brand-surface', 'text-slate-800', 'border', 'border-brand-border');
      });
      btn.classList.add('bg-brand-orchid', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-brand-surface', 'text-slate-800', 'border', 'border-brand-border');

      serviceCards.forEach((card) => {
        const cardCat = card.getAttribute('data-service-card');
        if (selectedCat === 'all' || cardCat === selectedCat) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
