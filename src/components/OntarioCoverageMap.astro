---
import { ontarioLocations } from '../data/locations';

const osmOntarioEmbed = 'https://www.openstreetmap.org/export/embed.html?bbox=-81.60%2C42.80%2C-75.80%2C45.50&layer=mapnik';
const osmOntarioFull = 'https://www.openstreetmap.org/#map=8/43.90/-79.60';
const googleMapsOntario = 'https://www.google.com/maps/search/In-Home+Autism+Therapy+Ontario+Canada';
---

<section class="py-12 bg-white border-b border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 to-brand-dark text-white rounded-3xl p-6 sm:p-8 shadow-card border border-brand-orchid/30 relative overflow-hidden">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-white/10 pb-5 mb-6 gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs uppercase tracking-wider font-bold text-brand-peony">Real-Time Province-Wide OpenStreetMap</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Southern Ontario In-Home Coverage Map</h2>
          <p class="text-slate-300 text-sm mt-1 max-w-2xl font-medium">
            Live geographic territory across the Greater Toronto Area, Golden Horseshoe, and Eastern Ontario where clinical duos provide in-home therapy.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href={googleMapsOntario}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/95 hover:bg-white text-slate-800 px-3.5 py-2 rounded-xl shadow-md border border-slate-200 transition-all active:scale-95 text-xs font-bold flex items-center gap-1.5 backdrop-blur-sm group cursor-pointer"
          >
            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Open in Google Maps</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href={osmOntarioFull}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/10 hover:bg-white/20 text-white px-3.5 py-2 rounded-xl border border-white/20 transition-all active:scale-95 text-xs font-bold flex items-center gap-1.5 backdrop-blur-sm cursor-pointer"
          >
            <span>OpenStreetMap Fullscreen</span>
            <svg class="w-3 h-3 text-brand-peony" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Real Map Canvas -->
      <div class="relative w-full rounded-2xl overflow-hidden border border-white/20 bg-slate-950 shadow-2xl">
        <iframe
          title="Ontario Real OpenStreetMap Territory View"
          src={osmOntarioEmbed}
          class="w-full h-[450px] sm:h-[550px] border-0 rounded-2xl filter brightness-95 contrast-105"
          loading="lazy"
          allowfullscreen
        ></iframe>

        <!-- Floating Quick Stats Badge -->
        <div class="absolute bottom-4 left-4 z-10 bg-slate-900/95 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/20 text-xs text-slate-200 shadow-2xl pointer-events-none hidden sm:block max-w-xs">
          <div class="flex items-center gap-2 font-bold text-white">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>68+ Ontario Municipalities Serviced</span>
          </div>
          <div class="text-[11px] text-slate-300 mt-1">
            Real OpenStreetMap cartography covering GTA, Golden Horseshoe, &amp; Eastern Ontario within 250km
          </div>
        </div>
      </div>

      <!-- Quick Regional Hub Shortcuts -->
      <div class="mt-5 pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-300">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mr-1">Direct Regional Links:</span>
          {ontarioLocations.filter((_, idx) => idx % 6 === 0).map((loc) => (
            <a
              href={`/locations/${loc.slug}`}
              class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-slate-200 border border-white/10 hover:border-brand-orchid transition-all font-semibold text-xs"
            >
              {loc.name}
            </a>
          ))}
        </div>
        <div class="text-slate-400 text-xs">
          Live cartography provided by <a href="https://www.openstreetmap.org" target="_blank" rel="noopener noreferrer" class="underline text-brand-peony">OpenStreetMap</a>
        </div>
      </div>
    </div>
  </div>
</section>
