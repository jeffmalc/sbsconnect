---
import { ontarioLocations } from '../data/locations';

const locationsData = ontarioLocations.map((loc) => ({
  slug: loc.slug,
  name: loc.name,
  region: loc.region,
  approxDistanceKm: loc.approxDistanceKm,
  lat: loc.coordinates.lat,
  lng: loc.coordinates.lng,
  population: loc.populationEstimate,
}));
---

<section class="py-12 bg-white border-b border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 to-brand-dark text-white rounded-3xl p-6 sm:p-8 shadow-card border border-brand-orchid/30 relative overflow-hidden">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-white/10 pb-5 mb-6 gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs uppercase tracking-wider font-bold text-brand-peony">Greater Toronto &amp; Southern Ontario Territory Map</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Interactive Province-Wide Coverage</h2>
          <p class="text-slate-300 text-sm mt-1 max-w-2xl font-medium">
            Explore 68+ cities and municipalities within 250km where certified in-home ABA therapist duos travel directly to family homes.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="reset-ontario-map"
            class="bg-white/95 hover:bg-white text-slate-800 px-3.5 py-2 rounded-xl shadow-md border border-slate-200 transition-all active:scale-95 text-xs font-bold flex items-center gap-1.5 backdrop-blur-sm cursor-pointer"
          >
            <svg class="w-4 h-4 text-brand-orchid" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Reset Ontario View</span>
          </button>
        </div>
      </div>

      <!-- Real Map Canvas -->
      <div class="relative w-full rounded-2xl overflow-hidden border border-white/15 bg-slate-950 shadow-inner">
        <div
          id="ontario-coverage-map"
          class="w-full h-[450px] sm:h-[550px] z-0"
          data-locations={JSON.stringify(locationsData)}
        >
          <!-- Fallback loading state -->
          <div class="w-full h-full flex flex-col items-center justify-center bg-slate-900/80 text-slate-400 p-6 text-center">
            <div class="w-10 h-10 border-4 border-brand-orchid border-t-transparent rounded-full animate-spin mb-3"></div>
            <p class="text-sm font-semibold text-white">Loading Ontario Cartography...</p>
            <p class="text-xs text-slate-400 mt-1">Mapping 68+ Community Clinical Zones</p>
          </div>
        </div>

        <!-- Floating Quick Stats Badge -->
        <div class="absolute bottom-4 left-4 z-[400] bg-slate-900/90 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/15 text-xs text-slate-200 shadow-xl pointer-events-none hidden sm:block">
          <div class="flex items-center gap-2 font-bold text-white">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <span>68+ Ontario Municipalities Mapped</span>
          </div>
          <div class="text-[11px] text-slate-400 mt-0.5">
            Click any pin to inspect team coverage or open city page
          </div>
        </div>
      </div>

      <!-- Legend -->
      <div class="mt-4 pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-300">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 rounded-full bg-brand-orchid border border-white/60"></span>
            <span>Active Service Location Pin</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 rounded-full border border-dashed border-emerald-400 bg-emerald-400/20"></span>
            <span>Direct In-Home Therapist Coverage Radius</span>
          </div>
        </div>
        <div class="text-slate-400 text-xs">
          Interactive map powered by CartoDB &amp; OpenStreetMap
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    function initOntarioMap() {
      if (typeof L === 'undefined') {
        setTimeout(initOntarioMap, 80);
        return;
      }

      const mapEl = document.getElementById('ontario-coverage-map');
      if (!mapEl || mapEl.dataset.initialized === 'true') return;
      mapEl.dataset.initialized = 'true';

      // Clear loading state
      mapEl.innerHTML = '';

      const locations = JSON.parse(mapEl.dataset.locations || '[]');
      const defaultCenter = [43.90, -79.60]; // Centered around Greater Toronto / Central Southern Ontario
      const defaultZoom = 8;

      const map = L.map('ontario-coverage-map', {
        center: defaultCenter,
        zoom: defaultZoom,
        minZoom: 6,
        maxZoom: 16,
        scrollWheelZoom: false,
        zoomControl: true,
      });

      // CartoDB Voyager High-Res Tiles
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      }).addTo(map);

      // Plot all location pins with circle radius
      locations.forEach(function(loc) {
        // Subtle coverage perimeter circle
        L.circle([loc.lat, loc.lng], {
          color: '#8224e3',
          fillColor: '#8224e3',
          fillOpacity: 0.08,
          weight: 1,
          dashArray: '3, 3',
          radius: 10000,
        }).addTo(map);

        // Custom City Pin Icon
        const cityPin = L.divIcon({
          className: 'ontario-city-pin',
          html: '<div style="width: 22px; height: 22px; border-radius: 50%; background: #8224e3; border: 2px solid #ffffff; box-shadow: 0 3px 8px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; color: #ffffff; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform=\'scale(1.25)\'" onmouseout="this.style.transform=\'scale(1)\'">' +
                  '<div style="width: 7px; height: 7px; border-radius: 50%; background: #ffffff;"></div>' +
                '</div>',
          iconSize: [22, 22],
          iconAnchor: [11, 11],
        });

        const marker = L.marker([loc.lat, loc.lng], { icon: cityPin }).addTo(map);
        marker.bindPopup(
          '<div style="font-family: Montserrat, sans-serif; min-width: 210px; padding: 2px;">' +
            '<span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #8224e3; letter-spacing: 0.5px;">' + loc.region + '</span>' +
            '<h4 style="font-size: 15px; font-weight: 700; color: #0f172a; margin: 2px 0 4px 0;">' + loc.name + '</h4>' +
            '<p style="font-size: 12px; color: #475569; margin: 0 0 10px 0; line-height: 1.4;">Direct in-home ABA therapy and clinical supervision teams active across ' + loc.name + ' and adjacent areas.</p>' +
            '<a href="/locations/' + loc.slug + '" style="display: block; text-align: center; padding: 6px 12px; background: linear-gradient(135deg, #8224e3 0%, #b02994 100%); color: #ffffff; font-size: 11px; font-weight: 700; border-radius: 9999px; text-decoration: none; box-shadow: 0 3px 8px rgba(130, 36, 227, 0.3);">' +
              'View ' + loc.name + ' Service Details &rarr;' +
            '</a>' +
          '</div>'
        );
      });

      // Reset Button
      const resetBtn = document.getElementById('reset-ontario-map');
      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          map.setView(defaultCenter, defaultZoom);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initOntarioMap);
    } else {
      initOntarioMap();
    }
  })();
</script>
