---
---
<!-- SECTION: FOR CLINICIANS & THERAPY TEAMS (JOIN THE NETWORK) -->
<section id="for-therapists" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="bg-gradient-to-r from-brand-dark via-brand-amethyst to-brand-dark rounded-3xl p-8 sm:p-14 text-white relative overflow-hidden shadow-2xl"
    >
      <!-- Decorative Background Elements -->
      <div
        class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-brand-orchid/30 blur-3xl pointer-events-none"
      >
      </div>

      <div class="max-w-3xl">
        <span
          class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/10 text-brand-peony border border-white/15"
        >
          Clinician Network Opportunity
        </span>
        <h2 class="text-3xl sm:text-5xl font-bold mt-4 leading-tight">
          Are You an Instructor Therapist or Registered Behaviour Analyst?
        </h2>
        <p class="mt-4 text-slate-200 text-base sm:text-lg leading-relaxed">
          Experience the freedom of an independent contractor with none of the isolation. Side by Side Therapy Connect
          matches you with motivated families in your preferred travel radius while providing compliant CPBAO Standard
          4.4 supervision frameworks.
        </p>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-2xl font-bold text-brand-peony mb-1">100% Autonomy</div>
            <p class="text-xs text-slate-300">
              Choose your caseload, set your geographic boundaries, and accept or decline client referrals without
              penalty.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-2xl font-bold text-brand-ocean mb-1">CPBAO Standard 4.4</div>
            <p class="text-xs text-slate-300">
              Pre-established, compliant clinical supervision agreements between qualified RBAs and Instructor
              Therapists.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
            <div class="text-2xl font-bold text-emerald-400 mb-1">Guaranteed Fees</div>
            <p class="text-xs text-slate-300">
              Competitive hourly remuneration for direct sessions with centralized PHIPA digital records.
            </p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <button
            type="button"
            data-open-clinician-modal
            class="px-8 py-3.5 rounded-full bg-brand-orchid hover:bg-brand-amethyst text-white font-bold text-sm shadow-glow-orchid transition-all active:scale-95"
          >
            Apply to Join the Roster
          </button>
          <button
            type="button"
            data-open-llms-modal
            class="px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-all"
          >
            View CPBAO Supervision Framework
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
