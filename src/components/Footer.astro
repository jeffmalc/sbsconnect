---
---
<!-- FOOTER: LEGAL, PHIPA & REGULATORY DISCLOSURES -->
<footer class="bg-brand-dark text-slate-400 text-xs py-14 border-t border-brand-orchid/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Col 1: Brand & Purpose -->
      <div class="space-y-3">
        <a href="/" class="inline-block bg-white p-2.5 rounded-2xl shadow-sm">
          <img
            src="/logo.png"
            alt="Side by Side Therapy Connect"
            class="h-12 w-auto object-contain"
          />
        </a>
        <p class="leading-relaxed text-slate-400">
          A specialized healthcare connection platform matching families with vetted, independent in-home autism therapy
          teams throughout Ontario.
        </p>
        <div class="text-[11px] text-slate-500 pt-1">Operated by Side by Side Therapy Inc. (Ontario, Canada)</div>
      </div>

      <!-- Col 2: Hub Locations -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-3">Ontario Service Hubs</h3>
        <ul class="space-y-1.5 text-slate-400">
          <li><a href="/locations/toronto" class="hover:text-white transition-colors">Toronto & GTA</a></li>
          <li><a href="/locations/mississauga" class="hover:text-white transition-colors">Mississauga & Brampton</a></li>
          <li><a href="/locations/vaughan" class="hover:text-white transition-colors">Vaughan & Markham</a></li>
          <li><a href="/locations/oakville" class="hover:text-white transition-colors">Oakville & Burlington</a></li>
          <li><a href="/locations/hamilton" class="hover:text-white transition-colors">Hamilton & Niagara</a></li>
          <li><a href="/locations/kitchener" class="hover:text-white transition-colors">Kitchener-Waterloo & Guelph</a></li>
          <li><a href="/locations/barrie" class="hover:text-white transition-colors">Barrie & Simcoe County</a></li>
          <li><a href="/locations/ottawa" class="hover:text-white transition-colors">Ottawa & Eastern Ontario</a></li>
          <li class="pt-1"><a href="/locations" class="text-brand-peony hover:underline font-semibold">View All 49+ Locations &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Regulatory Compliance -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-3">Governance & Standards</h3>
        <ul class="space-y-1.5 text-slate-400">
          <li>Psychology & Applied Behaviour Analysis Act, 2021</li>
          <li>CPBAO Standard 4.4 Supervision Agreements</li>
          <li>Personal Health Information Protection Act (PHIPA)</li>
          <li>Childhood Budgets & OAP Core Clinical Ready</li>
        </ul>
      </div>

      <!-- Col 4: Platform Utilities -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-3">AI & Transparency</h3>
        <p class="text-xs text-slate-400 mb-3">
          Inspect our static Knowledge Base and validated Schema markup for AI engines and health registries:
        </p>
        <div class="flex flex-col gap-2">
          <button
            type="button"
            data-open-llms-modal
            class="w-full py-2 px-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-mono text-[11px] text-left flex justify-between items-center border border-white/10"
          >
            <span>/llms.txt AI Agent Spec</span>
            <span class="text-brand-peony">→</span>
          </button>
          <button
            type="button"
            data-open-schema-modal
            class="w-full py-2 px-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-mono text-[11px] text-left flex justify-between items-center border border-white/10"
          >
            <span>MedicalBusiness JSON-LD</span>
            <span class="text-brand-ocean">→</span>
          </button>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px]">
      <p>© 2026 Side by Side Therapy Inc. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#funding" class="hover:text-white transition-colors">PHIPA Privacy Policy</a>
        <a href="#how-it-works" class="hover:text-white transition-colors">CPBAO Clinical Compliance</a>
        <a href="#for-therapists" class="hover:text-white transition-colors">Contractor Terms</a>
      </div>
    </div>
  </div>
</footer>
