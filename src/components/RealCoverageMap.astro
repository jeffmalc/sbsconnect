---
import type { LocationInfo } from '../data/locations';

interface Props {
  location: LocationInfo;
}

const { location } = Astro.props;

const lat = location.coordinates.lat;
const lng = location.coordinates.lng;

// Calculate real bounding box around the city for OpenStreetMap embed
const minLng = (lng - 0.08).toFixed(4);
const minLat = (lat - 0.05).toFixed(4);
const maxLng = (lng + 0.08).toFixed(4);
const maxLat = (lat + 0.05).toFixed(4);

const osmEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${minLng}%2C${minLat}%2C${maxLng}%2C${maxLat}&layer=mapnik&marker=${lat}%2C${lng}`;
const osmFullUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=13/${lat}/${lng}`;
const googleMapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.name + ', Ontario In-Home Autism Therapy')}`;
const googleMapsSatelliteUrl = `https://www.google.com/maps/@${lat},${lng},14z/data=!3m1!1e3`;
---

<div class="bg-gradient-to-br from-slate-900 to-brand-dark text-white rounded-3xl p-6 sm:p-7 shadow-card border border-brand-orchid/30 relative overflow-hidden flex flex-col">
  <!-- Map Header & Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-white/10 pb-4 mb-4 gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-[11px] uppercase tracking-wider font-bold text-brand-peony">Real-Time OpenStreetMap</span>
      </div>
      <h3 class="text-xl font-bold text-white mt-0.5">{location.name} Real Map &amp; Coverage</h3>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>15km In-Home Radius Active</span>
      </span>
    </div>
  </div>

  <!-- Real Interactive Map Viewport -->
  <div class="relative w-full rounded-2xl overflow-hidden border border-white/20 bg-slate-900 shadow-2xl flex-grow">
    <!-- Official Real OpenStreetMap Interactive Frame -->
    <iframe
      title={`${location.name} Real OpenStreetMap Coverage Territory`}
      src={osmEmbedUrl}
      class="w-full h-[380px] sm:h-[440px] border-0 rounded-2xl filter brightness-95 contrast-105"
      loading="lazy"
      allowfullscreen
    ></iframe>

    <!-- Floating Map Controls Overlay (Google Maps & Satellite Launchers) -->
    <div class="absolute top-3 right-3 z-10 flex flex-wrap gap-2">
      <a
        href={googleMapsSearchUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Open in Google Maps"
        class="bg-white/95 hover:bg-white text-slate-800 px-3 py-1.5 rounded-xl shadow-lg border border-slate-200 transition-all active:scale-95 text-xs font-bold flex items-center gap-1.5 backdrop-blur-sm group cursor-pointer"
      >
        <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Open in Google Maps</span>
        <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <a
        href={googleMapsSatelliteUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Open Google Maps Satellite View"
        class="bg-slate-900/90 hover:bg-slate-900 text-white px-3 py-1.5 rounded-xl shadow-lg border border-white/20 transition-all active:scale-95 text-xs font-bold flex items-center gap-1.5 backdrop-blur-sm group hidden sm:flex cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-brand-ocean" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Satellite View</span>
      </a>
    </div>

    <!-- Live Hub Badge Overlay at Bottom Left -->
    <div class="absolute bottom-3 left-3 z-10 bg-slate-900/95 backdrop-blur-md px-3.5 py-2.5 rounded-2xl border border-white/20 text-xs text-slate-200 shadow-2xl max-w-[280px] pointer-events-none">
      <div class="font-bold text-white flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-ocean animate-ping"></span>
        <span>{location.name} In-Home Hub Pin</span>
      </div>
      <div class="text-[11px] text-slate-300 mt-1">
        Direct clinician dispatch across {location.name} • In-home therapy coverage
      </div>
    </div>
  </div>

  <!-- Legend & Real School Map Links Footer -->
  <div class="mt-4 pt-3 border-t border-white/10 flex flex-col gap-3">
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-slate-300">
      <div class="flex flex-wrap items-center gap-3">
        <span class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-blue-500 border border-white/50"></span>
          <span>OpenStreetMap Live Pin</span>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-brand-orchid border border-white/50"></span>
          <span>In-Home Service Territory</span>
        </span>
      </div>
      <a
        href={osmFullUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-peony hover:underline font-semibold text-xs inline-flex items-center gap-1"
      >
        <span>View Fullscreen on OpenStreetMap</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Direct School GPS Launchers -->
    <div class="pt-2 border-t border-white/10 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">View Schools on Map:</span>
      {(location.schools || []).map((sch) => (
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(sch.name + ' ' + location.name + ' Ontario')}`}
          target="_blank"
          rel="noopener noreferrer"
          title={`View ${sch.name} on Google Maps`}
          class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-slate-200 border border-white/10 hover:border-brand-orchid transition-all inline-flex items-center gap-1 font-medium text-[11px]"
        >
          <span>📍 {sch.name.split('/')[0].trim()}</span>
          <svg class="w-2.5 h-2.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>
