---
import { therapyTeamsData } from '../data/therapyTeams';
---
<!-- SECTION: THERAPY TEAMS DIRECTORY (CONNECTED CLINICIANS) -->
<section id="directory" class="py-20 playful-dots">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-ocean/15 text-xs uppercase tracking-widest font-extrabold text-brand-ocean">
          <span aria-hidden="true">👩‍⚕️</span> Pre-Paired In-Home Duos
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">
          Meet Your Connected Therapy Teams in Ontario
        </h2>
        <p class="mt-2 text-slate-600 text-sm sm:text-base font-medium max-w-2xl">
          Every card introduces your front-line Instructor Therapist alongside the licensed Supervising R.B.A. (Ont.) who oversees your child's playful growth.
        </p>
      </div>

      <!-- Live Counter & Active Filters Indicator -->
      <div class="flex items-center gap-3">
        <span
          id="resultsCountBadge"
          aria-live="polite"
          class="px-4 py-2.5 rounded-full bg-white text-xs sm:text-sm font-extrabold text-brand-dark border-2 border-brand-border shadow-sm"
        >
          Showing {therapyTeamsData.length} Teams Available
        </span>
        <button
          id="resetFiltersBtn"
          type="button"
          class="px-3.5 py-2 rounded-full bg-white border border-brand-border text-xs font-bold text-brand-orchid hover:bg-brand-orchid hover:text-white transition-all shadow-sm"
        >
          Reset All ↺
        </button>
      </div>
    </div>

    <!-- Filter Control Tabs -->
    <div class="bg-white p-5 sm:p-6 rounded-[2rem] border-2 border-brand-border shadow-card mb-10 space-y-5">
      <!-- Region Filter Pills -->
      <div>
        <span class="flex items-center gap-1.5 text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-3">
          <span aria-hidden="true">📍</span> 1. Pick Your Neighbourhood Region:
        </span>
        <div class="flex flex-wrap gap-2" id="regionFiltersContainer">
          <button
            type="button"
            class="region-btn btn-playful active px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-brand-orchid text-white shadow-sm"
            data-region="all">🌎 All Ontario</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="toronto">🏙️ Toronto Central</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="peel">🏡 Peel (Mississauga / Brampton)</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="york">🌳 York Region</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="ottawa">🏛️ Ottawa</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="waterloo">🎓 Waterloo / Guelph</button
          >
          <button
            type="button"
            class="region-btn btn-playful px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-slate-800 hover:bg-brand-peony/25"
            data-region="hamilton">⚓ Hamilton / Halton</button
          >
        </div>
      </div>

      <!-- Specialty Quick Tags -->
      <div class="pt-4 border-t border-brand-border/60 flex flex-wrap items-center gap-2.5">
        <span class="flex items-center gap-1.5 text-xs font-extrabold text-slate-700 uppercase tracking-wider mr-1">
          <span aria-hidden="true">🎯</span> 2. Filter by Play &amp; Skill Focus:
        </span>
        <button
          type="button"
          class="tag-btn btn-playful text-xs font-bold px-4 py-2 rounded-full border-2 border-slate-200 bg-brand-surface/50 text-slate-700 hover:border-brand-orchid transition-all"
          data-tag="aac">💬 Non-Vocal / AAC</button
        >
        <button
          type="button"
          class="tag-btn btn-playful text-xs font-bold px-4 py-2 rounded-full border-2 border-slate-200 bg-brand-surface/50 text-slate-700 hover:border-brand-orchid transition-all"
          data-tag="toilet">🪥 Toileting &amp; Daily Routines</button
        >
        <button
          type="button"
          class="tag-btn btn-playful text-xs font-bold px-4 py-2 rounded-full border-2 border-slate-200 bg-brand-surface/50 text-slate-700 hover:border-brand-orchid transition-all"
          data-tag="assent">💛 Assent &amp; Play-Based</button
        >
        <button
          type="button"
          class="tag-btn btn-playful text-xs font-bold px-4 py-2 rounded-full border-2 border-slate-200 bg-brand-surface/50 text-slate-700 hover:border-brand-orchid transition-all"
          data-tag="school">🎒 Kindergarten / School Prep</button
        >
      </div>
    </div>

    <!-- Clinician Teams Grid (Server-Rendered for SEO + Client-Filtered) -->
    <div id="therapyTeamsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        therapyTeamsData.map((team) => (
          <article
            class="team-card card-playful scroll-reveal bg-white p-6 sm:p-7 border-2 border-brand-border flex flex-col justify-between group"
            data-team-id={team.id}
            data-region={team.region}
            data-tags={team.tags.join(',')}
          >
            <div>
              <!-- Region Badge & Active Status -->
              <div class="flex items-center justify-between gap-2 mb-5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-surface text-brand-dark border border-brand-border">
                  <svg class="w-3.5 h-3.5 text-brand-ocean" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {team.regionName}
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                  In-Home Ready
                </span>
              </div>

              <!-- Front-Line Instructor Therapist Info -->
              <div class="flex items-center gap-4 mb-5">
                <div class="relative shrink-0">
                  <img
                    src={team.therapist.avatar}
                    alt={team.therapist.name}
                    loading="lazy"
                    class="w-16 h-16 rounded-2xl object-cover border-2 border-brand-orchid/40 shadow-md group-hover:scale-105 transition-transform"
                  />
                  <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-white border border-brand-border flex items-center justify-center text-xs shadow-sm" aria-hidden="true">
                    🧩
                  </span>
                </div>
                <div>
                  <h3 class="font-extrabold text-slate-900 text-lg leading-snug group-hover:text-brand-orchid transition-colors">
                    {team.therapist.name}
                  </h3>
                  <span class="text-xs font-bold text-brand-orchid block mt-0.5">{team.therapist.title}</span>
                  <span class="text-xs text-slate-500 font-semibold">{team.therapist.experience}</span>
                </div>
              </div>

              <!-- Regulatory Supervision Disclosure (CPBAO Requirement) -->
              <div class="p-4 rounded-2xl brand-gradient-soft border border-brand-border mb-5 text-xs sm:text-sm">
                <div class="flex items-center justify-between text-[11px] font-extrabold text-slate-600 uppercase tracking-wider mb-1.5">
                  <span>Paired Supervising R.B.A.</span>
                  <span class="px-2 py-0.5 rounded-md bg-white text-brand-ocean font-mono border border-brand-border/80">{team.supervisor.cpbaoReg}</span>
                </div>
                <div class="font-extrabold text-slate-900 flex items-center gap-1.5 text-sm">
                  <svg class="w-4 h-4 text-brand-ocean shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    />
                  </svg>
                  {team.supervisor.name}
                </div>
                <div class="text-xs text-slate-600 font-medium mt-0.5">{team.supervisor.credentials}</div>
              </div>

              <!-- Disciplines Pills -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {team.disciplines.map((d) => (
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-surface text-brand-dark border border-brand-border/70">{d}</span>
                ))}
              </div>
            </div>

            <!-- Card Actions -->
            <div class="pt-4 border-t border-slate-100 flex items-center gap-2.5">
              <button
                type="button"
                data-view-team={team.id}
                aria-label={`View profile for ${team.therapist.name} and ${team.supervisor.name}`}
                class="btn-playful flex-1 py-3 rounded-2xl bg-brand-surface hover:bg-brand-peony/25 text-brand-dark font-bold text-xs border border-brand-border"
              >
                👋 Meet Duo
              </button>
              <button
                type="button"
                data-connect-team={team.id}
                aria-label={`Request match with ${team.therapist.name}`}
                class="btn-playful flex-1 py-3 rounded-2xl brand-gradient text-white font-bold text-xs shadow-glow-orchid text-center"
              >
                ✨ Request Match
              </button>
            </div>
          </article>
        ))
      }

      <!-- Empty State Card -->
      <div
        id="emptyTeamsMessage"
        class="hidden col-span-full py-16 text-center bg-white rounded-[2rem] border-2 border-brand-border p-8 shadow-card"
      >
        <div
          class="w-16 h-16 rounded-2xl bg-brand-peony/20 text-brand-orchid flex items-center justify-center mx-auto mb-4 text-3xl"
          aria-hidden="true"
        >
          🔍
        </div>
        <h3 class="text-xl font-extrabold text-slate-900">No Pre-Paired Teams Matching Those Exact Filters Yet</h3>
        <p class="text-sm text-slate-600 mt-2 max-w-md mx-auto font-medium">
          New clinical duos join every week across Ontario! Tell us what you're looking for and our Care Coordinator will hand-match a team near you.
        </p>
        <button
          type="button"
          data-start-intake-wizard
          class="btn-playful mt-6 px-7 py-3.5 rounded-full brand-gradient text-white font-bold text-xs sm:text-sm shadow-glow-orchid"
        >
          Request a Custom Team Match ✨
        </button>
      </div>
    </div>
  </div>
</section>
