---
---
<!-- TOP ANNOUNCEMENT BAR (OAP & CPBAO COMPLIANCE BANNER) -->
<aside
  aria-label="Regulatory Notice"
  class="bg-gradient-to-r from-brand-dark via-brand-amethyst to-brand-dark text-white text-xs sm:text-sm py-2 px-4 border-b border-brand-orchid/30"
>
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <a
        href="https://cpbao.ca"
        target="_blank"
        rel="noopener noreferrer"
        title="College of Psychologists and Behaviour Analysts of Ontario (Official Register)"
        class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-ocean text-white hover:bg-white hover:text-brand-dark transition-colors uppercase tracking-wider"
      >
        <span>CPBAO Standard 4</span>
        <svg class="w-2.5 h-2.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <span class="text-slate-100">
        All connections feature direct supervision by licensed <strong class="text-white"
          >Registered Behaviour Analysts (R.B.A. Ont.)</strong
        >. No tiered middlemen.
      </span>
    </div>
    <div class="flex items-center gap-4 text-xs sm:text-sm">
      <a
        href="https://www.ontario.ca/page/ontario-autism-program"
        target="_blank"
        rel="noopener noreferrer"
        title="Official Ontario Autism Program Information & Guidelines"
        class="text-brand-peony hover:text-white underline font-semibold transition-colors inline-flex items-center gap-1"
      >
        <span>Ontario Autism Program (OAP) Invoicing Ready</span>
        <svg class="w-3 h-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <button
        type="button"
        data-open-schema-modal
        class="hidden md:inline-flex items-center gap-1 text-slate-300 hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-brand-ocean" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
        >
        GEO / Schema View
      </button>
    </div>
  </div>
</aside>

<!-- MAIN NAVIGATION BAR (BRAND BOOK: 25px CLEAR PADDING & >= 80px MIN LOGO) -->
<header class="sticky top-0 z-40 glass-nav border-b border-brand-border/80 shadow-sm">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo Container with Required 25px Padding & Minimum Width -->
    <a href="/#hero" class="flex items-center gap-3 p-[10px] md:p-[15px] group rounded-2xl">
      <img
        src="/logo.png"
        alt="Side by Side Therapy Connect Home"
        class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation Menu (Playful Pill Style) -->
    <nav class="hidden lg:flex items-center gap-1.5 bg-brand-surface/80 p-1.5 rounded-full border border-brand-border/70" aria-label="Primary">
      <a
        href="/#how-it-works"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all"
        >How It Works</a
      >
      <a
        href="/#directory"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all"
        >Meet Teams</a
      >
      <a
        href="/locations"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all inline-flex items-center gap-1"
      >
        <span>Locations</span>
        <span class="px-1.5 py-0.2 rounded-full bg-brand-ocean/15 text-brand-ocean text-[10px] font-extrabold">69</span>
      </a>
      <a
        href="/#services"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all"
        >Services</a
      >
      <a
        href="/#pricing"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all"
        >OAP Calculator</a
      >
      <a
        href="/#for-therapists"
        class="px-3.5 py-2 rounded-full font-bold text-sm text-slate-800 hover:text-brand-orchid hover:bg-white hover:shadow-sm transition-all"
        >For Clinicians</a
      >
    </nav>

    <!-- Action Buttons & Quick Modals -->
    <div class="hidden sm:flex items-center gap-2.5">
      <button
        type="button"
        data-open-llms-modal
        aria-label="Open llms.txt AI Knowledge Graph"
        class="px-3 py-2 rounded-full text-slate-600 hover:text-brand-orchid hover:bg-brand-peony/20 transition-all border border-brand-border/60 bg-white shadow-sm"
      >
        <span class="text-xs font-mono font-bold">llms.txt</span>
      </button>

      <button
        type="button"
        data-start-intake-wizard
        class="btn-playful inline-flex items-center gap-2 px-5 py-3 rounded-full text-sm font-bold text-white brand-gradient shadow-glow-orchid group"
      >
        <span>Find My Team Match</span>
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-white/20 transition-transform group-hover:translate-x-0.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"
            ></path></svg
          >
        </span>
      </button>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobileMenuBtn"
      type="button"
      class="lg:hidden p-2.5 rounded-2xl text-slate-700 bg-brand-surface hover:bg-brand-peony/20 border border-brand-border transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          id="menuIconClosed"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
        <path
          id="menuIconOpen"
          class="hidden"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileMenu" class="hidden lg:hidden border-t border-brand-border bg-white px-6 py-6 space-y-4 shadow-2xl rounded-b-3xl">
    <nav class="flex flex-col space-y-2" aria-label="Mobile">
      <a href="/#how-it-works" data-mobile-nav-link class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors"
        >✨ How We Connect</a
      >
      <a href="/#directory" data-mobile-nav-link class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors"
        >👩‍⚕️ Meet Therapy Teams</a
      >
      <a href="/locations" data-mobile-nav-link class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors"
        >📍 All 69 Ontario Locations</a
      >
      <a href="/#services" data-mobile-nav-link class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors"
        >🧩 In-Home Disciplines</a
      >
      <a href="/#pricing" data-mobile-nav-link class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors"
        >🧮 OAP Cost Calculator</a
      >
      <a
        href="/#for-therapists"
        data-mobile-nav-link
        class="px-4 py-2.5 rounded-2xl text-base font-bold text-slate-800 hover:bg-brand-surface hover:text-brand-orchid transition-colors">🤝 Join as Clinician</a
      >
    </nav>
    <div class="pt-4 border-t border-slate-100 flex flex-col gap-3">
      <button
        type="button"
        data-mobile-nav-link
        data-start-intake-wizard
        class="btn-playful w-full py-3.5 rounded-full text-center font-bold text-white brand-gradient shadow-glow-orchid"
      >
        Find My Team Match →
      </button>
      <div class="flex items-center justify-between text-xs text-slate-500 pt-1 px-2">
        <button type="button" data-mobile-nav-link data-open-llms-modal class="underline font-semibold hover:text-brand-orchid"
          >View llms.txt standard</button
        >
        <button type="button" data-mobile-nav-link data-open-schema-modal class="underline font-semibold hover:text-brand-orchid"
          >View JSON-LD Schema</button
        >
      </div>
    </div>
  </div>
</header>
