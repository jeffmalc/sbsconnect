---
---
<!-- HERO SECTION: THE CONNECTION ENGINE -->
<section
  id="hero"
  class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28 bg-gradient-to-b from-white via-brand-surface to-white"
>
  <!-- Background Ambient Blobs -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-peony/20 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>
  <div
    class="absolute top-10 right-10 w-96 h-96 bg-brand-ocean/15 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Positioning Tagline Badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-brand-peony/50 text-brand-dark shadow-sm text-xs md:text-sm font-semibold mb-6"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-brand-ocean animate-pulse"></span>
        <span>Bridging Families & Autonomous In-Home Clinical Duos Across Ontario</span>
      </div>

      <!-- Main H1 Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.15]">
        We Connect Families with Dedicated <span class="brand-gradient-text">In-Home Therapy Teams</span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-lg sm:text-xl text-slate-700 font-medium leading-relaxed max-w-3xl mx-auto">
        Stop waiting on impersonal agency lists. We hand-pair your family with a certified <span
          class="font-bold text-brand-orchid">Instructor Therapist</span
        > backed by a dedicated <span class="font-bold text-brand-ocean"
          >Registered Behaviour Analyst (R.B.A. Ont.)</span
        >—delivering neurodiversity-affirming care right where your child lives, plays, and thrives.
      </p>

      <!-- Core Fast Matching Widget Bar -->
      <div class="mt-10 max-w-3xl mx-auto bg-white p-3 md:p-4 rounded-3xl shadow-card border border-brand-border/80">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
          <!-- Region / City Input -->
          <div class="p-2.5 rounded-2xl bg-brand-surface/70 border border-brand-border/60">
            <label for="heroRegionSelect" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1"
              >Your Ontario Region</label
            >
            <select
              id="heroRegionSelect"
              class="w-full bg-transparent text-sm font-semibold text-slate-900 focus:outline-none cursor-pointer"
            >
              <option value="all">All Ontario Hubs</option>
              <option value="toronto">Toronto / Central</option>
              <option value="peel">Peel (Mississauga / Brampton)</option>
              <option value="york">York Region (Vaughan / Markham)</option>
              <option value="ottawa">Ottawa & Eastern Ontario</option>
              <option value="waterloo">Waterloo / Kitchener / Guelph</option>
              <option value="hamilton">Hamilton / Halton / Niagara</option>
            </select>
          </div>

          <!-- Child's Primary Need / Focus -->
          <div class="p-2.5 rounded-2xl bg-brand-surface/70 border border-brand-border/60">
            <label for="heroGoalSelect" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1"
              >Primary Clinical Goal</label
            >
            <select
              id="heroGoalSelect"
              class="w-full bg-transparent text-sm font-semibold text-slate-900 focus:outline-none cursor-pointer"
            >
              <option value="all">Any Focus Area</option>
              <option value="communication">Speech & Functional AAC</option>
              <option value="daily-living">Daily Routines & Toilet Training</option>
              <option value="regulation">Assent-Based Emotion Regulation</option>
              <option value="school">School & Social Transition</option>
            </select>
          </div>

          <!-- Match Trigger Button -->
          <div class="flex items-center">
            <button
              id="heroQuickFilterBtn"
              type="button"
              class="w-full h-full min-h-[50px] py-3 px-6 rounded-2xl brand-gradient text-white font-bold text-sm shadow-glow-orchid hover:opacity-95 transition-all flex items-center justify-center gap-2 active:scale-95"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
              >
              <span>Find Matches</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Trust Badges Row -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-y-3 gap-x-6 text-xs sm:text-sm font-bold text-slate-700">
        <a
          href="https://cpbao.ca"
          target="_blank"
          rel="noopener noreferrer"
          title="College of Psychologists and Behaviour Analysts of Ontario"
          class="inline-flex items-center gap-1.5 hover:text-brand-dark transition-colors group"
        >
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span class="group-hover:underline">CPBAO Direct Supervision (Standard 4)</span>
          <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
        <a
          href="https://www.ontario.ca/page/ontario-autism-program"
          target="_blank"
          rel="noopener noreferrer"
          title="Ontario Autism Program Official Guidelines"
          class="inline-flex items-center gap-1.5 hover:text-brand-dark transition-colors group"
        >
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span class="group-hover:underline">OAP Core Clinical Services Invoicing</span>
          <svg class="w-3 h-3 text-slate-400 group-hover:text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"
            ><path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path></svg
          >
          Ontario PHIPA-Compliant Data Safe
        </span>
      </div>

      <!-- Hero Image Showcase -->
      <div class="mt-10 sm:mt-12 relative max-w-5xl mx-auto">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white ring-1 ring-brand-border/60 bg-slate-100 group">
          <img
            src="/images/hero-in-home-therapy.jpg"
            alt="Indian female pediatric therapist in her early 30s sitting on a soft living room rug engaging a 4-year-old boy in play-based therapy with wooden building blocks"
            class="w-full h-auto max-h-[500px] md:max-h-[560px] object-cover object-center transform transition-transform duration-700 group-hover:scale-[1.015]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1376"
            height="768"
          />
          <!-- Ambient subtle vignette gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/15 to-transparent pointer-events-none"></div>

          <!-- Bottom Left Overlay Card -->
          <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 text-left max-w-sm sm:max-w-md bg-white/95 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/60 shadow-xl">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-700">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark">Natural Environment Teaching</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-800 font-medium leading-snug">
              Compassionate 1-on-1 therapy where your child feels safest—playing, communicating, and learning at home.
            </p>
          </div>

          <!-- Bottom Right Floating Indicator -->
          <div class="hidden sm:inline-flex absolute bottom-6 right-6 items-center gap-2 bg-slate-900/90 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/20 text-white text-xs font-bold shadow-xl">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-ocean animate-pulse"></span>
            <span>R.B.A. (Ont.) Clinical Supervision</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
