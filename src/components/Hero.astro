---
---
<!-- HERO SECTION: THE PLAYFUL CONNECTION ENGINE -->
<section
  id="hero"
  class="relative overflow-hidden pt-10 pb-16 md:pt-16 md:pb-24 playful-dots border-b border-brand-border/60"
>
  <!-- Soft Playful Ambient Blobs -->
  <div
    class="absolute top-20 left-1/4 -translate-x-1/2 w-[500px] h-[500px] bg-brand-peony/25 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>
  <div
    class="absolute top-12 right-12 w-96 h-96 bg-brand-ocean/20 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Split Layout: Friendly Copy + Hero Image Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Friendly Copy & Value Prop (7 Cols) -->
      <div class="lg:col-span-6 text-center lg:text-left">
        <!-- Playful Welcome Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border-2 border-brand-peony/60 text-brand-dark shadow-sm text-xs sm:text-sm font-bold mb-6"
        >
          <span class="text-base" aria-hidden="true">👋</span>
          <span>Play-Based In-Home Therapy Across Ontario</span>
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </div>

        <!-- Main H1 Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-tight text-slate-900 leading-[1.12]">
          We Connect Families with Dedicated <span class="brand-gradient-text">In-Home Therapy Teams</span>
        </h1>

        <!-- Friendly Subheadline -->
        <p class="mt-5 text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Skip the stressful agency waitlists! We hand-pair your child with a warm, certified <span
            class="font-bold text-brand-orchid bg-brand-orchid/10 px-2 py-0.5 rounded-lg">Instructor Therapist</span
          > and a licensed <span class="font-bold text-brand-ocean bg-brand-ocean/10 px-2 py-0.5 rounded-lg"
            >Registered Behaviour Analyst (R.B.A. Ont.)</span
          >—turning everyday play in your living room into joyful milestones.
        </p>

        <!-- Playful Quick Highlights Pills -->
        <div class="mt-6 flex flex-wrap items-center justify-center lg:justify-start gap-2.5 text-xs font-bold text-slate-700">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-white border border-brand-border shadow-sm">
            <span class="text-base" aria-hidden="true">🧸</span>
            <span>100% Child-Led &amp; Assent-Based</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-white border border-brand-border shadow-sm">
            <span class="text-base" aria-hidden="true">🏡</span>
            <span>Right in Your Living Room</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-white border border-brand-border shadow-sm">
            <span class="text-base" aria-hidden="true">✨</span>
            <span>Direct OAP Billing Ready</span>
          </span>
        </div>

        <!-- Primary & Secondary Friendly CTAs -->
        <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-3.5">
          <button
            type="button"
            data-start-intake-wizard
            class="btn-playful inline-flex items-center gap-2.5 px-7 py-4 rounded-full brand-gradient text-white font-bold text-sm sm:text-base shadow-glow-orchid"
          >
            <span>Start Easy 2-Min Match Quiz</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
          <a
            href="#directory"
            class="btn-playful inline-flex items-center gap-2 px-6 py-4 rounded-full bg-white hover:bg-brand-surface text-brand-dark font-bold text-sm sm:text-base border-2 border-brand-border shadow-sm"
          >
            <span>Browse Available Teams</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Hero Photograph Showcase (6 Cols) -->
      <div class="lg:col-span-6 relative">
        <!-- Decorative Playful Floating Badge Top-Left -->
        <div
          class="hidden sm:flex animate-float-slow absolute -top-5 -left-4 z-20 items-center gap-2.5 bg-white px-4 py-2.5 rounded-2xl border-2 border-brand-peony/50 shadow-xl"
        >
          <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg" aria-hidden="true">🧱</span>
          <div class="text-left">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-brand-orchid">Play-Based Learning</span>
            <span class="block text-xs font-bold text-slate-800">Natural Environment Teaching</span>
          </div>
        </div>

        <!-- Main Hero Image Frame -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white ring-2 ring-brand-border/80 bg-slate-100 group">
          <img
            src="/images/hero-in-home-therapy.jpg"
            alt="Indian female pediatric therapist in her early 30s sitting on a soft living room rug engaging a 4-year-old boy in play-based therapy with wooden building blocks"
            class="w-full h-auto aspect-[16/10] object-cover object-center transform transition-transform duration-700 group-hover:scale-[1.02]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1376"
            height="768"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/10 to-transparent pointer-events-none"></div>

          <!-- Bottom Overlay Card inside Image -->
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-5 sm:left-5 sm:right-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white/95 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-white/80 shadow-xl">
            <div class="flex items-center gap-3 text-left">
              <span class="w-10 h-10 rounded-xl brand-gradient text-white flex items-center justify-center shrink-0 shadow-sm text-lg" aria-hidden="true">
                💛
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-extrabold uppercase tracking-wider text-brand-dark">Dedicated Clinical Duo</span>
                  <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">CPBAO Standard 4</span>
                </div>
                <p class="text-xs text-slate-700 font-semibold mt-0.5">
                  1-on-1 Instructor Therapist + Direct R.B.A. (Ont.) Supervision
                </p>
              </div>
            </div>
            <a
              href="https://members.cpbao.ca/public_register/new"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl bg-brand-surface hover:bg-brand-peony/25 text-brand-orchid text-xs font-bold border border-brand-border transition-colors shrink-0"
            >
              <span>Verify R.B.A.</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Fast-Match Bar (Below Split Hero) -->
    <div class="mt-12 max-w-4xl mx-auto bg-white p-4 sm:p-6 rounded-[2rem] shadow-card border-2 border-brand-border">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4 px-1">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-xl bg-brand-orchid/15 text-brand-orchid flex items-center justify-center font-bold text-sm" aria-hidden="true">🔍</span>
          <span class="text-sm sm:text-base font-extrabold text-slate-900">Quick Team Finder</span>
          <span class="text-xs text-slate-500 font-medium hidden sm:inline">— Filter pre-paired in-home teams in seconds</span>
        </div>
        <div class="flex items-center gap-4 text-xs font-bold">
          <a
            href="https://cpbao.ca"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-ocean hover:underline inline-flex items-center gap-1"
          >
            <span>✓ CPBAO Regulated</span>
          </a>
          <a
            href="https://www.ontario.ca/page/ontario-autism-program"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-orchid hover:underline inline-flex items-center gap-1"
          >
            <span>✓ OAP Eligible</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
        <!-- Region / City Input -->
        <div class="p-3 rounded-2xl bg-brand-surface/90 border border-brand-border hover:border-brand-orchid/50 transition-colors">
          <label for="heroRegionSelect" class="flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">
            <span aria-hidden="true">📍</span>
            <span>1. Your Ontario Region</span>
          </label>
          <select
            id="heroRegionSelect"
            class="w-full bg-transparent text-sm font-bold text-slate-900 focus:outline-none cursor-pointer"
          >
            <option value="all">All Ontario Hubs (69 Cities)</option>
            <option value="toronto">Toronto / Central</option>
            <option value="peel">Peel (Mississauga / Brampton)</option>
            <option value="york">York Region (Vaughan / Markham)</option>
            <option value="ottawa">Ottawa &amp; Eastern Ontario</option>
            <option value="waterloo">Waterloo / Kitchener / Guelph</option>
            <option value="hamilton">Hamilton / Halton / Niagara</option>
          </select>
        </div>

        <!-- Child's Primary Need / Focus -->
        <div class="p-3 rounded-2xl bg-brand-surface/90 border border-brand-border hover:border-brand-orchid/50 transition-colors">
          <label for="heroGoalSelect" class="flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">
            <span aria-hidden="true">🎯</span>
            <span>2. Child's Focus Area</span>
          </label>
          <select
            id="heroGoalSelect"
            class="w-full bg-transparent text-sm font-bold text-slate-900 focus:outline-none cursor-pointer"
          >
            <option value="all">Any Play or Developmental Goal</option>
            <option value="communication">Speech &amp; Functional AAC</option>
            <option value="daily-living">Daily Routines &amp; Toilet Training</option>
            <option value="regulation">Assent-Based Emotion Regulation</option>
            <option value="school">School &amp; Social Transition</option>
          </select>
        </div>

        <!-- Match Trigger Button -->
        <div class="flex items-center">
          <button
            id="heroQuickFilterBtn"
            type="button"
            class="btn-playful w-full h-full min-h-[56px] py-3.5 px-6 rounded-2xl brand-gradient text-white font-bold text-sm sm:text-base shadow-glow-orchid flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
            >
            <span>Show My Matches</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
